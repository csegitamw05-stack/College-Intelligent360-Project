PROJECT_NAME="Campus Intelligence 360"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="campus_intel_db"

# Direct Database URL (Override if using custom connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_intel_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (JSON array format)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Security Configuration
SECRET_KEY="change_this_in_production_secret_key_campus_intel_360"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
